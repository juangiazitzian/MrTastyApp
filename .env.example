# =============================================================================
# Variables de entorno · Mr Tasty Operaciones
# Copiá este archivo como .env.local para desarrollo.
# En producción se cargan en Vercel (Project → Settings → Environment Variables).
# .env.local NUNCA se sube al repositorio.
# =============================================================================

# --- Base de datos (Turso / libSQL) ------------------------------------------
# Desarrollo: alcanza con un archivo local, sin cuenta ni token.
TURSO_DATABASE_URL="file:./local.db"
# Producción: la URL libsql:// que da Turso, más su token.
# TURSO_DATABASE_URL="libsql://mrtasty-xxxx.turso.io"
# TURSO_AUTH_TOKEN=""

# --- Acceso (Auth.js + Google) -----------------------------------------------
# Secreto de firma de sesión. Generalo con: npx auth secret
AUTH_SECRET=""

# Credenciales del cliente OAuth web de Google Cloud Console.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Quiénes pueden entrar, separados por coma. Si queda vacío NO entra nadie.
ALLOWED_EMAILS="mrtastysanmiguel@gmail.com"

# Atajo para probar en tu máquina sin dar de alta un cliente OAuth de Google.
# Agrega un botón "Entrar en modo desarrollo" en la pantalla de acceso.
# Tiene dos candados y hacen falta los dos: que NODE_ENV no sea production y
# que esta variable valga 1. Vercel compila siempre con NODE_ENV=production,
# así que este atajo no existe en el sitio publicado ni aunque la cargues ahí.
DEV_AUTH_BYPASS="1"

# --- Originales de facturas (Vercel Blob) ------------------------------------
# Lo inyecta Vercel al crear el Blob store; sólo hace falta copiarlo para
# trabajar en local.
BLOB_READ_WRITE_TOKEN=""
